{
  "name": "@pagina/example-worker-r2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The pagina editor's HTTP contract as a Cloudflare Worker over R2.",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 127.0.0.1",
