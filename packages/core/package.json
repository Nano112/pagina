{
  "name": "@pagina/core",
  "version": "0.4.0",
  "description": "Article model for pagina: parses an article folder of YAML and Markdown into a typed manifest plus HTML fragments, and builds the section-level search index.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "documentation",
    "markdown",
    "static-site",
    "pagina"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/pagina.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Nano112/pagina/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Nano112/pagina/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "development": "./src/search.ts",
      "import": "./dist/search.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo",
    "scripts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2"
  },
  "peerDependencies": {
    "@kineglyph/core": "^0.3.0"
  }
}
