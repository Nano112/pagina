{
  "name": "@pagina/cli",
  "version": "0.2.0",
  "description": "Command line interface for pagina: `pagina dev`, `pagina build`, `pagina pack`, and `pagina unpack` over an article folder.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "cli",
    "documentation",
    "static-site",
    "markdown",
    "pagina"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/pagina.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Nano112/pagina/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Nano112/pagina/issues"
  },
  "type": "module",
  "bin": {
    "pagina": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pagina/core": "^0.2.0",
    "@pagina/vite": "^0.2.0",
    "@pagina/shell-static": "^0.2.0"
  },
  "peerDependencies": {
    "@kineglyph/core": "^0.2.0",
    "@kineglyph/export": "^0.3.0",
    "@kineglyph/web": "^0.2.0"
  }
}
