{
  "name": "@pagina/shell-static",
  "version": "0.1.0",
  "description": "The static HTML shell for a pagina site: page chrome, CSS tokens, theming, and the browser runtime that hydrates figures and search.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "documentation",
    "static-site",
    "html",
    "theming",
    "pagina"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/pagina.git",
    "directory": "packages/shell-static"
  },
  "homepage": "https://github.com/Nano112/pagina/tree/main/packages/shell-static#readme",
  "bugs": {
    "url": "https://github.com/Nano112/pagina/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./interactive": {
      "types": "./dist/interactive.d.ts",
      "development": "./src/interactive.ts",
      "import": "./dist/interactive.js"
    },
    "./theming": {
      "types": "./dist/theming/index.d.ts",
      "development": "./src/theming/index.ts",
      "import": "./dist/theming/index.js"
    },
    "./pagina.css": "./dist/pagina.css",
    "./pagina.tokens.css": "./dist/pagina.tokens.css",
    "./pagina.reading.css": "./dist/pagina.reading.css",
    "./client/*": "./client/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "client",
    "scripts",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pagina/core": "^0.1.0",
    "markdown-it": "^14.1.0",
    "shiki": "^3.12.0"
  },
  "peerDependencies": {
    "@kineglyph/core": "^0.1.0",
    "@kineglyph/web": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@kineglyph/core": {
      "optional": true
    },
    "@kineglyph/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2"
  }
}
