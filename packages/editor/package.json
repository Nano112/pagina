{
  "name": "@pagina/editor",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "development": "./src/model/index.ts",
      "import": "./dist/model/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "development": "./src/store/index.ts",
      "import": "./dist/store/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./editor.iife.js": "./dist/editor.iife.js",
    "./editor.css": "./dist/editor.css",
    "./theme.css": "./src/ui/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pagina/core": "*",
    "@tiptap/core": "^3.7.2",
    "@tiptap/extension-code": "^3.7.2",
    "@tiptap/extension-color": "^3.7.2",
    "@tiptap/extension-highlight": "^3.7.2",
    "@tiptap/extension-image": "^3.7.2",
    "@tiptap/extension-link": "^3.7.2",
    "@tiptap/extension-table": "^3.7.2",
    "@tiptap/extension-text-style": "^3.7.2",
    "@tiptap/pm": "^3.7.2",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.7.2",
    "lucide-react": "^1.31.0",
    "markdown-it": "^14.1.0",
    "prosemirror-markdown": "^1.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^8.2.1"
  },
