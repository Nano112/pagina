{
  "name": "pagina",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/vite",
    "packages/shell-static",
    "packages/editor",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "link:kineglyph": "npm link @kineglyph/core @kineglyph/svg @kineglyph/anime @kineglyph/plot @kineglyph/scenes @kineglyph/web @kineglyph/export",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish",
    "adopt:kineglyph": "node scripts/adopt-kineglyph.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/pagina.git"
  },
  "author": "Harrison (https://github.com/Nano112)",
  "homepage": "https://github.com/Nano112/pagina#readme",
  "bugs": {
    "url": "https://github.com/Nano112/pagina/issues"
  }
}
